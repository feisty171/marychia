---
/**
 * Investor Relations page — annual reports by year.
 * Words and the report list come from src/content/investors.md; PDFs live in public/reports/.
 * To add a report, edit that file — not this one.
 */
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { frontmatter as c } from "../content/investors.md";
import { isPlaceholder, realUrl } from "../lib/links";

type Report = { year: string; title: string; file: string; cover?: string };

// File size, read from the PDF itself so nobody has to type it in
const sizeOf = (file: string) => {
  try {
    const bytes = fs.statSync(path.join(process.cwd(), "public", "reports", file)).size;
    return bytes > 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;
  } catch {
    return null; // listed but not uploaded yet
  }
};

const reports = (c.reports as Report[]).map((r) => {
  const size = r.file ? sizeOf(r.file) : null;
  return { ...r, href: size ? `/reports/${r.file}` : null, size };
});
const [latest, ...archive] = reports;
const sgx = realUrl(c.sgxUrl);
const email = isPlaceholder(c.enquiryEmail) ? null : c.enquiryEmail;
---
<Base
  title={c.seo.title}
  description={c.seo.description}
  current="investors"
  clearHeader
  bodyClass="page-investors"
  styles={["investors.css"]}
>
  <main>
    {/* Photo banner (hero.image in investors.md), framed like the Home, Shop and Treatments banners,
        with the see-through menu on it. Until a photo is added, a placeholder shows its size. */}
    <section class="ir-banner">
      <div class="ir-banner__media">
        {c.hero.image
          ? <img src={c.hero.image} alt={c.hero.imageAlt || ""} decoding="async" fetchpriority="high" />
          : <div class="ir-banner__ph" aria-hidden="true"><small>Photo · 2400 × 1100</small></div>}
        <div class="ir-banner__words">
          <p class="label ir-banner__eyebrow">{c.hero.eyebrow}</p>
          <h1 class="ir-banner__title">{c.hero.heading}</h1>
        </div>
      </div>
    </section>

    <section class="ir-hero">
      <div class="ir-container">
        <p class="ir-hero__lede">{c.hero.lede}</p>
      </div>
    </section>

    {latest && (
      <section class="ir-section" aria-labelledby="latest-heading">
        <div class="ir-container">
          <article class="ir-latest">
            <div class="ir-cover">
              {latest.cover
                ? <img src={latest.cover} alt={`Cover of ${latest.title}`} loading="lazy" />
                : (
                  <div class="ir-cover__ph" aria-hidden="true">
                    <span class="ir-cover__brand">MARY CHIA</span>
                    <span class="ir-cover__year">{latest.year}</span>
                    <span class="ir-cover__label">Annual Report</span>
                  </div>
                )}
            </div>
            <div class="ir-latest__body">
              <p class="eyebrow" id="latest-heading">{c.latestLabel}</p>
              <h2 class="ir-latest__title">{latest.title}</h2>
              {latest.href
                ? <a class="btn btn--solid ir-dl" href={latest.href} download>{c.downloadLabel} <span>· {latest.size}</span></a>
                : <span class="btn btn--solid ir-dl is-pending" aria-disabled="true">{c.comingSoonLabel}</span>}
            </div>
          </article>
        </div>
      </section>
    )}

    {archive.length > 0 && (
      <section class="ir-section ir-section--archive" aria-labelledby="archive-heading">
        <div class="ir-container">
          <h2 class="ir-heading" id="archive-heading">{c.archiveHeading}</h2>
          <ul class="ir-list">
            {archive.map((r) => (
              <li class="ir-row">
                <span class="ir-row__year">{r.year}</span>
                <span class="ir-row__title">{r.title}</span>
                {r.href
                  ? <a class="ir-row__dl" href={r.href} download aria-label={`${c.downloadLabel}: ${r.title}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg>
                      PDF · {r.size}
                    </a>
                  : <span class="ir-row__dl is-pending">{c.comingSoonLabel}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="ir-section ir-section--more">
      <div class="ir-container">
        <h2 class="ir-heading">{c.moreHeading}</h2>
        <div class="ir-more">
          <div class="ir-more__item">
            <p class="ir-more__k">{c.sgxLabel}</p>
            {sgx ? <a class="link-arrow" href={sgx} target="_blank" rel="noopener">Visit SGX</a> : <p class="ir-more__v">{c.sgxUrl}</p>}
          </div>
          <div class="ir-more__item">
            <p class="ir-more__k">{c.enquiryLabel}</p>
            {email ? <a class="ir-more__v" href={`mailto:${email}`}>{email}</a> : <p class="ir-more__v">{c.enquiryEmail}</p>}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
