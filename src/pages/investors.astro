---
/**
 * Investor Relations page: Annual Reports and Sustainability Reports, each newest first.
 * Words and both report lists come from src/content/investors.md; PDFs live in public/reports/.
 * To add a report, edit that file — not this one.
 */
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import PageBanner from "../components/PageBanner.astro";
import { frontmatter as c } from "../content/investors.md";
import { isPlaceholder, realUrl } from "../lib/links";

type Report = { title: string; date: string; file: string; note?: string };

// Is the PDF in public/reports/ yet? (its size, or null if not)
const sizeOf = (file: string) => {
  try {
    const bytes = fs.statSync(path.join(process.cwd(), "public", "reports", file)).size;
    return bytes > 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;
  } catch {
    return null; // listed but not uploaded yet
  }
};
// newest first (by date), linking to the PDF once it is in the folder
const prepare = (list: Report[] = []) =>
  [...list]
    .sort((a, b) => (b.date || "").localeCompare(a.date || ""))
    .map((r) => {
      const size = r.file ? sizeOf(r.file) : null;
      return { ...r, href: size ? `/reports/${r.file}` : null };
    });
const sections = [
  { id: "annual", heading: c.annualHeading, reports: prepare(c.annualReports) },
  { id: "sustainability", heading: c.sustainabilityHeading, reports: prepare(c.sustainabilityReports) },
].filter((x) => x.reports.length);
const sgx = realUrl(c.sgxUrl);
const email = isPlaceholder(c.enquiryEmail) ? null : c.enquiryEmail;
---
<Base
  title={c.seo.title}
  description={c.seo.description}
  current="investors"
  clearHeader
  bodyClass="page-investors"
  styles={["investors.css"]}
>
  <main>
    <PageBanner image={c.hero.image} imageAlt={c.hero.imageAlt} eyebrow={c.hero.eyebrow} heading={c.hero.heading} />

    <section class="ir-hero">
      <div class="ir-container">
        <p class="ir-hero__lede">{c.hero.lede}</p>
      </div>
    </section>

    {/* Annual Reports, then Sustainability Reports: each newest first (lists in investors.md) */}
    {sections.map((sec) => (
      <section class="ir-section" id={sec.id} aria-labelledby={`${sec.id}-heading`}>
        <div class="ir-container">
          <h2 class="ir-heading" id={`${sec.id}-heading`}>{sec.heading}</h2>
          <ul class="ir-list">
            {sec.reports.map((r) => (
              <li class="ir-row">
                {r.href
                  ? <a class="ir-row__link" href={r.href} target="_blank" rel="noopener" aria-label={`${r.title}${r.note ? `, ${r.note}` : ""} (PDF, opens in a new tab)`}>
                      <span class="ir-row__title">{r.title}{r.note && <small class="ir-row__note">{r.note}</small>}</span>
                      <span class="ir-row__open" aria-hidden="true">{c.openLabel} <svg viewBox="0 0 24 24"><path d="M8 16 16 8M9 8h7v7"/></svg></span>
                    </a>
                  : <span class="ir-row__link is-pending">
                      <span class="ir-row__title">{r.title}{r.note && <small class="ir-row__note">{r.note}</small>}</span>
                      <span class="ir-row__open">{c.comingSoonLabel}</span>
                    </span>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}

    <section class="ir-section ir-section--more">
      <div class="ir-container">
        <h2 class="ir-heading">{c.moreHeading}</h2>
        <div class="ir-more">
          <div class="ir-more__item">
            <p class="ir-more__k">{c.sgxLabel}</p>
            {sgx ? <a class="link-arrow" href={sgx} target="_blank" rel="noopener">Visit SGX</a> : <p class="ir-more__v">{c.sgxUrl}</p>}
          </div>
          <div class="ir-more__item">
            <p class="ir-more__k">{c.enquiryLabel}</p>
            {email ? <a class="ir-more__v" href={`mailto:${email}`}>{email}</a> : <p class="ir-more__v">{c.enquiryEmail}</p>}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
