---
/**
 * Gallery / Results page (/gallery/). Linked from the Treatments dropdown ("Gallery / Results").
 * Words and the list of results come from src/content/gallery.md — edit that file, not this one.
 * Treatment names and categories come from src/data/treatments.json (matched by id).
 * Styles: public/css/gallery.css · Filter buttons: public/js/gallery.js
 *
 * A result's photos only show when its `consent` is true; otherwise a placeholder shows.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { frontmatter as g } from "../content/gallery.md";
import data from "../data/treatments.json";

type Result = {
  treatment: string;
  note?: string;
  before?: string;
  after?: string;
  image?: string;
  alt?: string;
  consent?: boolean;
};

const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
const withEm = (s: string) => esc(s).replace(/\*(.+?)\*/g, "<em>$1</em>");

const byId = new Map(data.treatments.map((t: any) => [t.id, t]));
const results = (g.results as Result[]).map((r) => {
  const t: any = byId.get(r.treatment);
  const category: string = t?.category ?? "Face";
  const single = r.image !== undefined && r.before === undefined && r.after === undefined;
  const show = r.consent === true;
  return {
    ...r,
    name: t?.name ?? r.treatment,
    category,
    link: `/rituals/#${category.toLowerCase()}`,
    single,
    // A photo is shown only with consent; otherwise "" → placeholder.
    beforeSrc: show ? r.before ?? "" : "",
    afterSrc: show ? r.after ?? "" : "",
    imageSrc: show ? r.image ?? "" : "",
    // Photos were added but consent isn't confirmed yet: say so on the placeholder.
    awaiting: !show && !!(r.before || r.after || r.image),
  };
});
const filters: string[] = (g.filters as string[]).filter((f) => results.some((r) => r.category === f));
---
<Base
  title={g.seo.title}
  description={g.seo.description}
  current="gallery"
  solidHeader
  bodyClass="page-gallery"
  styles={["gallery.css"]}
  scripts={["gallery.js"]}
>
  <main>
    <section class="a-section gallery-page" id="results">
      <div class="a-container">
        <header class="g-head">
          <div>
            <p class="eyebrow">{g.eyebrow}</p>
            <h1 class="g-title" set:html={withEm(g.heading)} />
          </div>
          <p class="a-lede g-lede">{g.lede}</p>
        </header>

        {filters.length > 1 && (
          <div class="g-filters" role="group" aria-label="Show results for">
            <button type="button" class="g-chip" data-filter="all" aria-pressed="true">All <span>{results.length}</span></button>
            {filters.map((f) => (
              <button type="button" class="g-chip" data-filter={f.toLowerCase()} aria-pressed="false">
                {f} <span>{results.filter((r) => r.category === f).length}</span>
              </button>
            ))}
          </div>
        )}
        <p class="g-count" aria-live="polite" id="gCount">Showing {results.length} results</p>

        <ul class="g-grid" id="gGrid">
          {results.map((r) => (
            <li class="g-card" data-cat={r.category.toLowerCase()}>
              <figure class="g-figure">
                {r.single ? (
                  <div class="g-shot g-shot--wide">
                    {r.imageSrc
                      ? <img src={r.imageSrc} alt={r.alt ?? r.name} loading="lazy" decoding="async" />
                      : <div class="g-ph"><span class="g-ph__icon" aria-hidden="true">+</span><span class="g-ph__hint">{r.awaiting ? "Awaiting client consent" : "Photo · 1600 × 1200"}</span></div>}
                  </div>
                ) : (
                  <div class="g-pair">
                    {[["Before", r.beforeSrc], ["After", r.afterSrc]].map(([label, src]) => (
                      <div class="g-shot">
                        {src
                          ? <img src={src} alt={`${label}: ${r.alt ?? r.name}`} loading="lazy" decoding="async" />
                          : <div class="g-ph"><span class="g-ph__icon" aria-hidden="true">+</span><span class="g-ph__hint">{r.awaiting ? "Awaiting consent" : "800 × 1000"}</span></div>}
                        <span class="g-tag">{label}</span>
                      </div>
                    ))}
                  </div>
                )}
                <figcaption class="g-cap">
                  <p class="g-cat">{r.category}</p>
                  <h2 class="g-name"><a href={r.link}>{r.name}</a></h2>
                  {r.note && <p class="g-note">{r.note}</p>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="g-empty" id="gEmpty" hidden>No results in this category yet.</p>

        <p class="g-disclaimer">{g.disclaimer}</p>
      </div>
    </section>

    <section class="a-section a-section--tint g-cta">
      <div class="a-container">
        <div class="a-head a-head--center">
          <h2 class="a-title" set:html={withEm(g.cta.heading)} />
          <p class="a-lede">{g.cta.text}</p>
          <a class="btn btn--solid g-cta__btn" href={g.cta.link}>{g.cta.button}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
