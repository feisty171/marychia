---
/**
 * Gallery / Results page (/gallery/). Linked from the Treatments dropdown ("Gallery / Results").
 * Words come from src/content/gallery.md; each result is a file in src/data/results/ (Pages CMS).
 * Treatment names and categories come from src/data/treatment-menu.json (matched by name or ID),
 * photos from src/assets/results/ (resized automatically): see src/lib/results.ts.
 * Styles: public/css/gallery.css · Filter buttons: public/js/gallery.js
 *
 * A result's photos only show when its `consent` is true; otherwise a placeholder shows.
 */
import ResultCard from "../components/ResultCard.astro";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { frontmatter as g } from "../content/gallery.md";
import { loadResults, resolveResults } from "../lib/results";

const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
const withEm = (s: string) => esc(s).replace(/\*(.+?)\*/g, "<em>$1</em>");

// Treatment name, category and photos for each result: src/lib/results.ts
const results = (await resolveResults(loadResults())).map((r) => ({
  ...r,
  link: `/treatments/?area=${r.category.toLowerCase()}`,   // opens the matching tab (Face → Facials, Body / Wellness → Body & Wellness)
}));
const filters: string[] = (g.filters as string[]).filter((f) => results.some((r) => r.category === f));
---
<Base
  title={g.seo.title}
  description={g.seo.description}
  current="gallery"
  solidHeader
  bodyClass="page-gallery"
  styles={["gallery.css"]}
  scripts={["gallery.js"]}
>
  <main>
    <section class="a-section gallery-page" id="results">
      <div class="a-container">
        <header class="g-head">
          <div>
            <p class="eyebrow">{g.eyebrow}</p>
            <h1 class="g-title" set:html={withEm(g.heading)} />
          </div>
          <p class="a-lede g-lede">{g.lede}</p>
        </header>

        {filters.length > 1 && (
          <div class="g-filters" role="group" aria-label="Show results for">
            <button type="button" class="g-chip" data-filter="all" aria-pressed="true">All <span>{results.length}</span></button>
            {filters.map((f) => (
              <button type="button" class="g-chip" data-filter={f.toLowerCase()} aria-pressed="false">
                {f} <span>{results.filter((r) => r.category === f).length}</span>
              </button>
            ))}
          </div>
        )}
        <p class="g-count" aria-live="polite" id="gCount">Showing {results.length} results</p>

        <ul class="g-grid" id="gGrid">
          {results.map((r) => <ResultCard r={r} />)}
        </ul>
        <p class="g-empty" id="gEmpty" hidden>No results in this category yet.</p>

        <p class="g-disclaimer">{g.disclaimer}</p>
      </div>
    </section>

    <section class="a-section a-section--tint g-cta">
      <div class="a-container">
        <div class="a-head a-head--center">
          <h2 class="a-title" set:html={withEm(g.cta.heading)} />
          <p class="a-lede">{g.cta.text}</p>
          <a class="btn btn--solid g-cta__btn" href={g.cta.link}>{g.cta.button}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
