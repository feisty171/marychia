---
/**
 * Shop page (/shop/). The nav's "Shop" link opens it.
 * Words: src/content/shop.md. Products: src/data/products.json (made from the product sheet with
 * npm run build:products). Products are grouped by brand, in the order of `brands` in shop.md.
 * Each card (src/components/ShopCard.astro) shows photo, name and price, and opens the product
 * page /shop/<id>/ (src/pages/shop/[id].astro). Styles: public/css/shop.css.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import ShopCard from "../components/ShopCard.astro";
import { frontmatter as c } from "../content/shop.md";
import data from "../data/products.json";

const products = data.products as any[];
const order = [...c.brands.map((b: any) => b.name), ...products.map((p) => p.brand)].filter((b, i, a) => a.indexOf(b) === i);
const groups = order
  .map((name) => {
    const b = c.brands.find((x: any) => x.name === name) || {};
    let items = products.filter((p) => p.brand === name);
    // optional order: product IDs listed first, in that order; any others follow
    if (b.order?.length) items = [...items].sort((x, y) => {
      const ix = b.order.indexOf(x.id), iy = b.order.indexOf(y.id);
      return (ix < 0 ? 999 : ix) - (iy < 0 ? 999 : iy);
    });
    // "corner" title: "*Lucent* Collection" → [{ text: "Lucent", rose: true }, { text: "Collection" }]
    // one word per line; words inside *asterisks* in rose
    const words = (b.heading || name).split(/(\*[^*]+\*)/).map((t: string) => t.trim()).filter(Boolean)
      .flatMap((t: string) => t.replace(/\*/g, "").split(/\s+/).map((w) => ({ text: w, rose: t.startsWith("*") })));
    const thumb = b.thumb || items.find((p) => p.image)?.image || "";
    return { name, thumb: thumb && !thumb.startsWith("/") ? "/images/shop/" + thumb : thumb, line: b.line || "", layout: b.layout || "center", items, words, kicker: b.kicker || "", kickerInline: !!b.kickerInline };
  })
  .filter((g) => g.items.length);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const [h1, em, h2] = c.heading.split("*");
---
<Base
  title={c.seo.title}
  description={c.seo.description}
  current="shop"
  clearHeader
  bodyClass="page-shop"
  styles={["shop.css"]}
  scripts={["shop.js"]}
>
  <main>
    {/* Opening banner: a wide photo with the words on it, then a button per brand
        (photo: hero.image in src/content/shop.md; brand thumbs: the brand's first product photo) */}
    <section class="shop-page">
      <div class="shop-hero__wrap">
        <header class="shop-hero">
          <div class="shop-hero__media">
            {c.hero?.image
              ? <img src={c.hero.image} alt={c.hero.imageAlt || ""} decoding="async" fetchpriority="high" />
              : <div class="shop-hero__ph" aria-hidden="true"><small>Lifestyle photo · 2400 × 1100</small></div>}
            <div class="shop-hero__words">
              <p class="label shop-hero__eyebrow">{c.eyebrow}</p>
              <h1 class="shop-hero__title">{h1}{em && <em>{em}</em>}{h2}</h1>
              <p class="shop-hero__intro">{c.intro}</p>
            </div>
          </div>
          {c.hero?.brandButtons && groups.length > 1 && (
            <nav class="shop-hero__brands" aria-label="Brands">
              {groups.map((g) => (
                <a href={`#${slug(g.name)}`}>
                  <span class="shop-hero__thumb">{g.thumb ? <img src={g.thumb} alt="" loading="lazy" decoding="async" /> : null}</span>
                  <span class="shop-hero__bname">{g.name}<small>{g.items.length} {g.items.length === 1 ? "product" : "products"}</small></span>
                  <span class="shop-hero__arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </nav>
          )}
        </header>
      </div>
    </section>

    {/* Brand spreads, magazine style: a big bold brand title beside or above its products.
        layout (src/content/shop.md → brands): left | right (grey band) | center */}
    {groups.map((g, gi) => g.layout === "side" ? (
      /* "side": the big title on the left (at the bottom), the cards on the right */
      <section class="shop-spread shop-spread--side" id={slug(g.name)} aria-labelledby={`${slug(g.name)}-h`}>
        <div class="a-container shop-side">
          <div class="shop-side__title">
            <h2 class="shop-corner__h" id={`${slug(g.name)}-h`}>
              {g.kicker && !g.kickerInline && <span class="shop-corner__kicker">{g.kicker}</span>}
              {g.words.map((w: any, wi: number) => (
                <span class:list={["shop-corner__w", { "is-rose": w.rose }]}>
                  {wi === 0 && g.kicker && g.kickerInline && <span class="shop-corner__kicker shop-corner__kicker--inline">{g.kicker} </span>}{w.text}
                </span>
              ))}
            </h2>
            {g.line && <p class="shop-spread__line">{g.line}</p>}
          </div>
          <ul class="shop-side__grid">
            {g.items.map((p) => <li><ShopCard p={p} /></li>)}
          </ul>
        </div>
      </section>
    ) : g.layout === "corner" ? (
      /* "corner": cards in a 4-column grid (3 then 2) with the big title in the bottom-right corner */
      <section class="shop-spread shop-spread--corner" id={slug(g.name)} aria-labelledby={`${slug(g.name)}-h`}>
        <div class="a-container">
          <ul class="shop-corner">
            {g.items.map((p) => <li><ShopCard p={p} /></li>)}
            <li class="shop-corner__title">
              <h2 class="shop-corner__h" id={`${slug(g.name)}-h`}>
                {g.kicker && <span class="shop-corner__kicker">{g.kicker}</span>}
                {g.words.map((w: any) => <span class:list={["shop-corner__w", { "is-rose": w.rose }]}>{w.text}</span>)}
              </h2>
              {g.line && <p class="shop-spread__line">{g.line}</p>}
            </li>
          </ul>
        </div>
      </section>
    ) : (
      <section class={`shop-spread shop-spread--${g.layout}`} id={slug(g.name)} aria-labelledby={`${slug(g.name)}-h`}>
        <div class="a-container shop-spread__inner">
          <header class="shop-spread__head">
            <p class="shop-spread__index">{String(gi + 1).padStart(2, "0")} / {String(groups.length).padStart(2, "0")}</p>
            <h2 class="shop-spread__title" id={`${slug(g.name)}-h`}>{g.name}</h2>
            {g.line && <p class="shop-spread__line">{g.line}</p>}
            <p class="shop-spread__count">{g.items.length} {g.items.length === 1 ? "product" : "products"}</p>
          </header>
          <ul class={`shop-spread__grid shop-spread__grid--${Math.min(g.items.length, 5)}`}>
            {g.items.map((p) => <li><ShopCard p={p} /></li>)}
          </ul>
        </div>
      </section>
    ))}
  </main>

  <Footer />
</Base>
