---
/**
 * Treatments page (/treatments/): hero + Face/Body/Wellness tiles.
 * The full treatment list lives on its own page: src/pages/rituals.astro (/rituals/).
 * Design: mary-chia-treatments-page.zip (scoped styles in public/css/treatments.css).
 * Treatment list, prices, images and PDF settings: src/data/treatments.json
 * Studios for WhatsApp booking: src/data/outlets.json
 * Behaviour (search, filters, booking sheet): public/js/treatments.js
 * To change a treatment or price, edit the JSON file — not this one.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import MenuViewer from "../components/MenuViewer.astro";
import data from "../data/treatments.json";
import outlets from "../data/outlets.json";
import { isPlaceholder } from "../lib/links";

// Studios offered in the "Book on WhatsApp" sheet (only those with a confirmed WhatsApp number)
const studios = outlets
  .filter((o) => !isPlaceholder(o.whatsapp))
  .map((o) => ({
    id: o.name.toLowerCase().replace(/[^a-z0-9]+/g, "-"),
    name: o.name,
    address: `${o.address}, Singapore ${o.postalCode}`,
    office: o.phone,
    whatsapp: "65" + o.whatsapp.replace(/\D/g, "").slice(-8),
  }));
const pageData = { ...data, studios };

// ---------- New & trending banners ----------
// data.trending.banners: [wide 1920x480, half 960x480, half 960x480]. Empty image = placeholder.
const tr = data.trending;
const escHtml = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch]!);
const withEm = (s: string) => escHtml(s).replace(/\*(.+?)\*/g, "<em>$1</em>");
const BANNER_SIZES = ["1920 × 480", "960 × 480", "960 × 480"];
const banners = (tr.banners || []).slice(0, 3).map((b: any, i: number) => ({ ...b, size: BANNER_SIZES[i], n: i + 1 }));
---
<Base
  title="Treatments | Mary Chia"
  description="Signature face, body and wellness treatments at Mary Chia. Personalised care for your skin, body and wellbeing since 1982."
  current="treatments"
  bodyClass="page-treatments"
  styles={["treatments.css", "menu-viewer.css"]}
  scripts={["menu-viewer.js"]}
>

  <div class="tp" id="tp">
<main>
<!-- ======================= HERO ======================= -->
<section class="tp-hero" style={data.siteImages.hero ? `--tp-hero-img:url("${data.siteImages.hero}")` : undefined}>
  <div class="wrap">
    <h1>Treatments</h1>
    <p class="hero-sub">Face · Body · Wellness</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/rituals/">Explore</a>
      <a class="btn btn-ghost" href="/menu/" data-menu-viewer>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
        Full menu
      </a>
    </div>
  </div>
</section>

<!-- Category tiles: each opens the treatment list (/rituals/) filtered to that category -->
<div class="wrap tiles-wrap">
  <header class="tiles-head">
    <!-- Ribbon flourish (echoes the ribbon "M" in the logo); draws itself in when scrolled into view -->
    <svg class="svc-ribbon" viewBox="0 0 640 180" fill="none" aria-hidden="true" preserveAspectRatio="none">
      <path class="svc-ribbon__back" pathLength="1" d="M4 150C70 150 104 64 150 34c34-22 52 10 34 58-14 40-8 66 28 52 44-18 82-104 128-120 40-14 44 36 22 92-16 42 0 64 40 46 54-24 96-96 164-98 30-1 52 10 74 26" />
      <path class="svc-ribbon__front" pathLength="1" d="M4 150C70 150 104 64 150 34c34-22 52 10 34 58-14 40-8 66 28 52 44-18 82-104 128-120 40-14 44 36 22 92-16 42 0 64 40 46 54-24 96-96 164-98 30-1 52 10 74 26" />
    </svg>
    <div class="tiles-head__title">
      <p class="eyebrow">{data.services.eyebrow}</p>
      <h2 set:html={withEm(data.services.heading)} />
    </div>
    <p class="tiles-head__lede">{data.services.lede}</p>
  </header>
  <div class="tiles" id="tiles"></div>
</div>

<!-- ======================= NEW & TRENDING (banners) =======================
     Content: "trending" in src/data/treatments.json (heading + 3 banners). Styles: .trend-* in public/css/treatments.css -->
<section class="trend" id="trending" aria-labelledby="trendTitle">
  <div class="wrap">
    <header class="trend-head">
      <p class="eyebrow">{tr.eyebrow}</p>
      <h2 id="trendTitle" set:html={withEm(tr.heading)} />
      <p class="trend-lede">{tr.lede}</p>
    </header>

    <div class="trend-banners">
      {banners.map((b) => {
        const cls = ["trend-banner", b.n === 1 ? "trend-banner--wide" : "trend-banner--half"];
        const inner = b.image
          ? <img src={b.image} alt={b.alt || ""} loading="lazy" decoding="async" />
          : <span class="trend-banner__ph" role="img" aria-label={`Banner ${b.n} placeholder`}>
              <span class="trend-banner__label">Banner {b.n}</span>
              <span class="trend-banner__size">{b.size}</span>
            </span>;
        return b.image && b.link
          ? <a class:list={cls} href={b.link}>{inner}</a>
          : <div class:list={cls}>{inner}</div>;
      })}
    </div>
  </div>
</section>


</main>

  </div>

  <Footer />

  <script type="application/json" id="tp-data" set:html={JSON.stringify(pageData)}></script>
  <script is:inline src="/js/treatments.js"></script>
  <MenuViewer />
</Base>
