---
/**
 * Treatments page (/treatments/): hero + Face/Body/Wellness tiles.
 * The full treatment list lives on its own page: src/pages/rituals.astro (/rituals/).
 * Design: mary-chia-treatments-page.zip (scoped styles in public/css/treatments.css).
 * Treatment list, prices, images and PDF settings: src/data/treatments.json
 * Studios for WhatsApp booking: src/data/outlets.json
 * Behaviour (search, filters, booking sheet): public/js/treatments.js
 * To change a treatment or price, edit the JSON file — not this one.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import data from "../data/treatments.json";
import outlets from "../data/outlets.json";
import { isPlaceholder } from "../lib/links";

// Studios offered in the "Book on WhatsApp" sheet (only those with a confirmed WhatsApp number)
const studios = outlets
  .filter((o) => !isPlaceholder(o.whatsapp))
  .map((o) => ({
    id: o.name.toLowerCase().replace(/[^a-z0-9]+/g, "-"),
    name: o.name,
    address: `${o.address}, Singapore ${o.postalCode}`,
    office: o.phone,
    whatsapp: "65" + o.whatsapp.replace(/\D/g, "").slice(-8),
  }));
const pageData = { ...data, studios };

// ---------- Spotlight (New & trending) ----------
// Picks come from data.trending.items (by treatment id); name, description and "from" price from the treatment itself.
const tr = data.trending;
const escHtml = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch]!);
const withEm = (s: string) => escHtml(s).replace(/\*(.+?)\*/g, "<em>$1</em>");
const spotlight = tr.items
  .map((it) => ({ ...it, t: data.treatments.find((x) => x.id === it.id) }))
  .filter((x) => x.t)
  .slice(0, 4)
  .map((x) => {
    const t = x.t!;
    const src = !x.image ? "" : x.image.startsWith("/") ? x.image : data.config.treatmentImageBase + x.image;
    const from = data.config.currency + Math.min(...t.options.map((o) => o.price)).toLocaleString("en-SG");
    return { ...x, t, src, from };
  });
const pad = (n: number) => String(n).padStart(2, "0");
const ICON: Record<string, string> = {
  Face: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M12 3c-3.6 0-6 2.9-6 6.8 0 4.6 2.8 8.7 6 10.2 3.2-1.5 6-5.6 6-10.2C18 5.9 15.6 3 12 3Z"/><path d="M9.3 10.2h.01M14.7 10.2h.01M10 14.6c1.2.8 2.8.8 4 0"/></svg>',
  Body: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M3 15c3-1 4.5-3.5 9-3.5S18 14 21 15"/><path d="M5 18.5c2.4-.7 3.8-2 7-2s4.6 1.3 7 2"/><circle cx="12" cy="6.5" r="2.5"/></svg>',
  Wellness: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M12 21c-4-2.5-7-5.6-7-9.5C5 8 7.2 6 9.6 6c1 0 1.8.4 2.4 1 .6-.6 1.4-1 2.4-1C16.8 6 19 8 19 11.5c0 3.9-3 7-7 9.5Z"/><path d="M12 3v3M8.5 12.5c1 1.2 2.2 1.8 3.5 1.8s2.5-.6 3.5-1.8"/></svg>',
};
---
<Base
  title="Treatments | Mary Chia"
  description="Signature face, body and wellness treatments at Mary Chia. Personalised care for your skin, body and wellbeing since 1982."
  current="treatments"
  bodyClass="page-treatments"
  styles={["treatments.css"]}
>

  <div class="tp" id="tp">
<main>
<!-- ======================= HERO ======================= -->
<section class="tp-hero" style={data.siteImages.hero ? `--tp-hero-img:url("${data.siteImages.hero}")` : undefined}>
  <div class="wrap">
    <h1>Treatments</h1>
    <p class="hero-sub">Face · Body · Wellness</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/rituals/">Explore</a>
      <a class="btn btn-ghost js-pdf" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
        Full menu
      </a>
    </div>
    <a class="hero-dl js-pdf-dl">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14"/></svg>
      Download menu (PDF)
    </a>
  </div>
</section>

<!-- Category tiles: each opens the treatment list (/rituals/) filtered to that category -->
<div class="wrap tiles-wrap">
  <header class="tiles-head">
    <!-- Ribbon flourish (echoes the ribbon "M" in the logo); draws itself in when scrolled into view -->
    <svg class="svc-ribbon" viewBox="0 0 640 180" fill="none" aria-hidden="true" preserveAspectRatio="none">
      <path class="svc-ribbon__back" pathLength="1" d="M4 150C70 150 104 64 150 34c34-22 52 10 34 58-14 40-8 66 28 52 44-18 82-104 128-120 40-14 44 36 22 92-16 42 0 64 40 46 54-24 96-96 164-98 30-1 52 10 74 26" />
      <path class="svc-ribbon__front" pathLength="1" d="M4 150C70 150 104 64 150 34c34-22 52 10 34 58-14 40-8 66 28 52 44-18 82-104 128-120 40-14 44 36 22 92-16 42 0 64 40 46 54-24 96-96 164-98 30-1 52 10 74 26" />
    </svg>
    <div class="tiles-head__title">
      <p class="eyebrow">{data.services.eyebrow}</p>
      <h2 set:html={withEm(data.services.heading)} />
    </div>
    <p class="tiles-head__lede">{data.services.lede}</p>
  </header>
  <div class="tiles" id="tiles"></div>
</div>

<!-- ======================= SPOTLIGHT (New & trending) =======================
     Content: "trending" in src/data/treatments.json. Behaviour: public/js/trending.js -->
{spotlight.length > 0 && (
<section class="trend" id="trending" aria-labelledby="trendTitle" data-autoplay={tr.autoplaySeconds || 6}>
  <div class="wrap">
    <header class="trend-head">
      <p class="eyebrow">{tr.eyebrow}</p>
      <h2 id="trendTitle" set:html={withEm(tr.heading)} />
      <p class="trend-lede">{tr.lede}</p>
    </header>

    <div class="trend-grid">
      <!-- Photo stage: swaps with the active treatment -->
      <div class="trend-stage" aria-hidden="true">
        <span class="trend-ghost">01</span>
        <div class="trend-frame">
          {spotlight.map((x, i) => (
            <div class:list={["trend-slide", { "is-active": i === 0 }]} data-i={i}>
              {x.src
                ? <img src={x.src} alt="" loading="lazy" decoding="async" />
                : <div class="ph" data-cat={x.t.category}><div class="ph-inner"><span class="ph-icon" set:html={ICON[x.t.category] || ICON.Wellness} /><span class="ph-hint">Photo · 900 × 1100</span></div></div>}
              <span class="trend-slide__cat">{x.t.category}</span>
            </div>
          ))}
        </div>
        <svg class="trend-badge" viewBox="0 0 120 120">
          <defs><path id="trendCircle" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0" /></defs>
          <circle cx="60" cy="60" r="58" />
          <text><textPath href="#trendCircle">{`${tr.badge} · ${tr.badge} · `}</textPath></text>
          <path class="trend-badge__star" d="M60 47c1.6 7.6 5.4 11.4 13 13-7.6 1.6-11.4 5.4-13 13-1.6-7.6-5.4-11.4-13-13 7.6-1.6 11.4-5.4 13-13Z" />
        </svg>
        <p class="trend-count"><span class="trend-count__now">01</span><span class="trend-count__sep"></span><span>{pad(spotlight.length)}</span></p>
      </div>

      <!-- List: hover, click or use the arrow keys to switch -->
      <div class="trend-list" role="tablist" aria-orientation="vertical" aria-label={tr.eyebrow}>
        {spotlight.map((x, i) => (
          <div class:list={["trend-item", { "is-active": i === 0 }]} data-i={i}>
            <button class="trend-tab" type="button" role="tab" id={`trend-tab-${i}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`trend-panel-${i}`} tabindex={i === 0 ? 0 : -1}>
              <span class="trend-num">{pad(i + 1)}</span>
              <span class="trend-name">{x.t.name}</span>
              <span class="trend-tag">{x.label}</span>
            </button>
            <div class="trend-panel" role="tabpanel" id={`trend-panel-${i}`} aria-labelledby={`trend-tab-${i}`} inert={i !== 0}>
              <div class="trend-panel__inner">
                <p class="trend-for">{x.t.for}</p>
                <p class="trend-desc">{x.t.description}</p>
                <div class="trend-foot">
                  <p class="from">from <b>{x.from}</b></p>
                  <a class="trend-cta" href={`/rituals/#${x.t.category.toLowerCase()}`}>
                    See it on the menu
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                  </a>
                </div>
              </div>
            </div>
            <span class="trend-progress" aria-hidden="true"><i></i></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
)}


</main>

  </div>

  <Footer />

  <script type="application/json" id="tp-data" set:html={JSON.stringify(pageData)}></script>
  <script is:inline src="/js/treatments.js"></script>
  <script is:inline src="/js/trending.js"></script>
</Base>
