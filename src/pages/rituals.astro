---
/**
 * Rituals page (/rituals/): the full treatment list. Hero words: "ritualsHero" in src/data/treatments.json
 * with search, Face/Body/Wellness filters, session picker and WhatsApp booking.
 * Links like /rituals/?area=face open it filtered (older /rituals/#face links still work). The menu's "Treatments" item links here.
 * Design: mary-chia-treatments-page.zip (scoped styles in public/css/treatments.css).
 * Treatment list, prices, concerns and collections: the menu workbook → `npm run build:treatments`
 *   → src/data/treatment-menu.json. Page settings, photos and PDF settings: src/data/treatments.json
 * Studios for WhatsApp booking: src/data/outlets.json
 * Behaviour (search, filters, booking sheet): public/js/treatments.js
 * To change a treatment or price, edit the workbook and rerun `npm run build:treatments` — not this file.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import MenuViewer from "../components/MenuViewer.astro";
import { treatmentData as data } from "../lib/treatmentData";
import outlets from "../data/outlets.json";
import { isPlaceholder } from "../lib/links";

// Studios offered in the "Book on WhatsApp" sheet (only those with a confirmed WhatsApp number)
const studios = outlets
  .filter((o) => !isPlaceholder(o.whatsapp))
  .map((o) => ({
    id: o.name.toLowerCase().replace(/[^a-z0-9]+/g, "-"),
    name: o.name,
    address: `${o.address}, Singapore ${o.postalCode}`,
    office: o.phone,
    whatsapp: "65" + o.whatsapp.replace(/\D/g, "").slice(-8),
  }));
const pageData = { ...data, studios };
---
<Base
  title="Our Most-Loved Rituals | Mary Chia Treatments"
  description="Browse Mary Chia's signature face, body and wellness treatments, choose your session and book on WhatsApp with the studio nearest you."
  current="treatments"
  bodyClass="page-rituals"
  styles={["treatments.css", "menu-viewer.css"]}
  scripts={["menu-viewer.js"]}
>

  <div class="tp" id="tp">
<main>
<!-- ======================= HEADING (photo: "siteImages" → "rituals" in src/data/treatments.json) ======================= -->
<!-- Hero: heading and line centred over the photo (.tp-hero in public/css/treatments.css),
     in the shorter band (.tp-hero--short).
     Words: "ritualsHero" in src/data/treatments.json; photo: siteImages.rituals. -->
<section class="tp-hero tp-hero--short" style={data.siteImages.rituals ? `--tp-hero-img:url("${data.siteImages.rituals}")` : undefined}>
  <div class="wrap">
    {data.ritualsHero.eyebrow && <p class="eyebrow">{data.ritualsHero.eyebrow}</p>}
    <h1>{data.ritualsHero.heading}</h1>
    {data.ritualsHero.text && <p class="hero-lede">{data.ritualsHero.text}</p>}
  </div>
</section>

<!-- ======================= MENU ======================= -->
<section class="menu-section" id="menu">
  <div class="wrap">

    <div class="rl">
      <!-- Filter sidebar. Desktop: sticky column on the left. Phones/tablets: the "Filters" sheet.
           Options come from "filters" in src/data/treatments.json; behaviour is in public/js/treatments.js -->
      <aside class="fl" id="filters" aria-labelledby="flTitle">
        <div class="fl-head">
          <h2 class="fl-title" id="flTitle">Filters</h2>
          <button class="fl-clear" id="flClear" type="button" hidden>Clear all</button>
          <button class="fl-close" id="flClose" type="button" aria-label="Close filters">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
        <div class="fl-body">
          <div class="fl-group">
            <p class="fl-label" id="flAreaLabel">Area</p>
            <div class="seg" id="flArea" role="group" aria-labelledby="flAreaLabel"></div>
          </div>
          <fieldset class="fl-group">
            <legend class="fl-label">Concern</legend>
            <div class="fl-checks" id="flConcerns"></div>
            <button class="fl-more" id="flMore" type="button" aria-expanded="false" hidden></button>
          </fieldset>
          <!-- Budget: "All prices / First trial" switch, a bar of how many treatments sit at each
               price, and a two-handle slider from our cheapest to our most expensive price. -->
          <div class="fl-group fl-budget">
            <div class="fl-budget__head">
              <p class="fl-label fl-label--inline" id="flBudgetLabel">Budget</p>
              <p class="fl-budget__val" id="flPriceVal" aria-live="polite"></p>
            </div>
            <div class="seg seg--2" id="flPriceMode" role="group" aria-label="Prices to show">
              <button class="seg-btn" type="button" data-mode="all" aria-pressed="true">All prices<span class="seg-n" id="flModeAllN"></span></button>
              <button class="seg-btn" type="button" data-mode="trial" aria-pressed="false">First trial<span class="seg-n" id="flModeTrialN"></span></button>
            </div>
            <div class="range" id="flRange">
              <div class="range__bars" id="flBars" aria-hidden="true"></div>
              <div class="range__track" aria-hidden="true"><span class="range__fill" id="flFill"></span></div>
              <input class="range__input" id="flPriceMin" type="range" min="0" max="0" step="1" value="0" aria-label="Lowest price">
              <input class="range__input" id="flPriceMax" type="range" min="0" max="0" step="1" value="0" aria-label="Highest price">
            </div>
            <div class="range__ends" aria-hidden="true"><span id="flPriceLo"></span><span id="flPriceHi"></span></div>
          </div>
          <div class="fl-group">
            <p class="fl-label" id="flTimeLabel">Time</p>
            <div class="pills" id="flTime" role="group" aria-labelledby="flTimeLabel"></div>
          </div>
          <div class="fl-group fl-group--last">
            <button class="fl-disclosure" id="flCollBtn" type="button" aria-expanded="false" aria-controls="flColl">
              <span class="fl-label fl-label--inline" id="flCollText">Collection</span>
              <span class="fl-plus" aria-hidden="true"></span>
            </button>
            <div class="fl-checks fl-coll" id="flColl" hidden></div>
          </div>
        </div>
        <div class="fl-foot">
          <button class="btn btn-primary fl-apply" id="flApply" type="button">Show treatments</button>
        </div>
      </aside>
      <div class="fl-backdrop" id="flBackdrop" aria-hidden="true"></div>

      <div class="rl-main">
        <div class="toolbar" role="search">
          <label class="search">
            <span class="sr-only">Search treatments</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input id="search" type="search" autocomplete="off" placeholder="Search by treatment or concern, e.g. hydration, aches, cellulite" data-short-placeholder="Search treatments or concerns">
            <button class="search-clear" id="clearSearch" type="button" aria-label="Clear search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
          </label>
          <button class="fl-open" id="flOpen" type="button" aria-controls="filters" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
            <span class="fl-open__label">Filters</span> <span class="fl-open__n" id="flOpenN" hidden></span>
          </button>
        </div>
        <p class="status" id="status" aria-live="polite"></p>

        <div class="grid" id="grid"></div>
        <!-- Shows 12 cards, then the next 12 on each click (PAGE_SIZE in public/js/treatments.js) -->
        <div class="more-wrap" id="moreWrap" hidden>
          <button class="btn btn-ghost" id="moreCards" type="button">Show more</button>
        </div>

        <div class="empty" id="empty">
          <div class="ring" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M8.5 11h5"/></svg>
          </div>
          <h3>No treatments found matching your search</h3>
          <p id="emptyMsg">Try a different word, or explore one of these:</p>
          <div class="suggest" id="suggest"></div>
          <button class="btn btn-ghost" id="resetBtn" type="button">Reset search &amp; filters</button>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="wrap bottom-banner">
  <aside class="menu-banner" aria-label="Full treatment menu">
    <div class="booklet" aria-hidden="true"><img src="/images/site/menu-cover.webp" alt="" loading="lazy"></div>
    <div>
      <h2>Looking for something else?</h2>
      <p>Browse every therapy, add-on and package in our full Treatment Collection, or let our therapists recommend one for you.</p>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href="/menu/" data-menu-viewer>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
        View Full Menu
      </a>
      <a class="btn btn-ghost js-pdf-dl" aria-label="Download full menu PDF">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14"/></svg>
        Download
      </a>
    </div>
  </aside>
</div>
</main>

<!-- ======================= BOOKING SHEET ======================= -->
<div class="sheet-backdrop" id="sheet" aria-hidden="true">
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <button class="sheet-close" id="sheetClose" type="button" aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <p class="eyebrow">Book on WhatsApp</p>
    <h3 id="sheetTitle"></h3>
    <div class="studios" id="studioList"></div>
    <small>We'll open WhatsApp with your treatment details filled in. Our team will confirm your slot.</small>
  </div>
</div>
  </div>

  <Footer />

  <script type="application/json" id="tp-data" set:html={JSON.stringify(pageData)}></script>
  <script is:inline src="/js/treatments.js"></script>
  <MenuViewer />
</Base>
