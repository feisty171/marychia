---
/**
 * /rituals/ — the old treatment list was removed (the Treatments page is now /treatments/,
 * src/pages/treatments.astro). This tiny page only forwards old links and bookmarks there,
 * keeping any filter: /rituals/?area=face → /treatments/?area=face (which opens the Facials tab).
 * Visitors without JavaScript are forwarded by the meta refresh, or can tap the link.
 */
import site from "../data/site.json";
const target = new URL("/treatments/", site.url).href;
---
<!doctype html>
<html lang="en-SG">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Treatments | Mary Chia</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={target} />
  <noscript><meta http-equiv="refresh" content="0; url=/treatments/" /></noscript>
</head>
<body>
  <p>Our treatments have moved. <a id="go" href="/treatments/">Go to our treatments</a>.</p>
  <script is:inline>
    // Keep the filter from old links, e.g. /rituals/?area=body → /treatments/?area=body
    location.replace(document.getElementById("go").getAttribute("href") + location.search + location.hash);
  </script>
</body>
</html>
