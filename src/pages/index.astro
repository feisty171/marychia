---
/**
 * Home page template.
 * Words (hero included) come from src/content/home.md; outlets from src/data/outlets.json.
 * To change copy, edit those files — not this one.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import SignatureCard from "../components/SignatureCard.astro";
import CategoryTiles from "../components/CategoryTiles.astro";
import ProductCard from "../components/ProductCard.astro";
import FavouriteCard from "../components/FavouriteCard.astro";
import { treatmentData } from "../lib/treatmentData";
import BookingSheet from "../components/BookingSheet.astro";
import treatmentsData from "../data/treatments.json";
import site from "../data/site.json";
import outlets from "../data/outlets.json";
import { frontmatter as h } from "../content/home.md";
import { tel, waHref, realUrl } from "../lib/links";
import { loadResults, resolveResults } from "../lib/results";

const siteWa = waHref(site.whatsappUrl);
// "Book your escape": WhatsApp once the number is confirmed, otherwise the studio list
const bookHref = siteWa ?? "#visit";
// "Our clients' favourites": treatments picked by ID in home.md, details from the treatment list
const favs = (h.favourites?.items || [])
  .map((id: string) => treatmentData.treatments.find((t: any) => t.id === id))
  .filter(Boolean);
const [favBefore, favEm = "", favAfter = ""] = (h.favourites?.heading || "").split("*");
// Ad banner words (optional)
const bannerHasCopy = !!h.banner?.heading;
const [bannerBefore, bannerEm = "", bannerAfter = ""] = (h.banner?.heading || "").split("*");
// First-visit band
const [trialBefore, trialEm = "", trialAfter = ""] = (h.trial?.heading || "").split("*");
const trialTerms = realUrl(h.trial?.termsLink);
// "Real results": newest Gallery results (photos only with consent) + client reviews
const [resBefore, resEm = "", resAfter = ""] = (h.results?.heading || "").split("*");
const resultCards = (await resolveResults(loadResults().slice(0, h.results?.show ?? 3))).map((r) => ({
  name: r.name,
  note: r.note,
  alt: r.alt,
  link: `/rituals/?q=${encodeURIComponent(r.name)}`,
  single: r.imageSrc,
  before: r.beforeSrc,
  after: r.afterSrc,
}));
// "Read on Google": the studio's Google Maps page (src/data/outlets.json)
// Google Maps embed (no key needed) built from the studio's mapsUrl search words
const mapEmbed = (u: string) => "https://maps.google.com/maps?q=" + encodeURIComponent(new URL(u).searchParams.get("query") || "") + "&z=16&output=embed";
const googleFor = (studio?: string) => (outlets as any[]).find((o) => o.name === studio)?.mapsUrl || "";
// Review avatar colour: a steady hue picked from the reviewer's name, like Google's initials
const avatarHue = (n: string) => [...n].reduce((a, c) => a + c.charCodeAt(0), 0) % 360;
// "Find a treatment" heading: *words* become the large italic red line
const [findBefore, findEm = "", findAfter = ""] = (h.services?.heading || "").split("*");
const stars = (n: any) => (typeof n === "number" && n >= 1 ? Math.min(5, Math.round(n)) : 0);
// "Our story" heading: *words* in italic rose
const [storyBefore, storyEm = "", storyAfter = ""] = (h.experience?.heading || "").split("*");
// Hero headline: the *word* in asterisks shows in italic rose. Each word is wrapped
// so it can slide up into place when the page opens (public/css/home.css, .ed-hero__w).
// On wide screens the italic word starts the second line (.ed-hero__br).
const heroWords = h.hero.headline
  .split("*")
  .flatMap((part: string, i: number) => part.trim().split(/\s+/).filter(Boolean).map((w) => ({ w, em: i % 2 === 1 })));
---
<Base
  title="Mary Chia | Face • Body • Wellness"
  description="Mary Chia — the beauty and slimming specialist. Four decades of facial, spa and slimming expertise, personalised for your skin, your body and your goals."
  current="home"
  clearHeader
  styles={["home.css", "treatments.css"]}
  scripts={["treatment-cards.js", "home.js"]}
>
  <main>
    <!-- ============ HERO ============
         Words and photo: src/content/home.md → hero. Styles: "Hero" in public/css/home.css.
         public/js/home.js sets --hp (0 → 1) as the hero scrolls away; the photo fades and drifts. -->
    <section class="ed-hero" id="home">
      <!-- The photo is shown whole (never cropped): behind the words on wide screens, above them on phones -->
      <img class="ed-hero__bg" src={h.hero.image} alt={h.hero.imageAlt} width="1366" height="768" fetchpriority="high" />
      <div class="h-container ed-hero__grid">
        <div class="ed-hero__copy">
          <p class="ed-hero__eyebrow">{h.hero.eyebrow}</p>
          <h1 class="ed-hero__title">
            {heroWords.map((x, i) => (
              <>{x.em && (i === 0 || !heroWords[i - 1].em) && <br class="ed-hero__br" />}<span class="ed-hero__w" style={`--w:${i}`}><span>{x.em ? <em>{x.w}</em> : x.w}</span></span></>
            ))}
          </h1>
        </div>

        <div class="ed-hero__foot">
          <p class="ed-hero__lead">{h.hero.text}</p>
          <div class="ed-hero__actions">
            <a class="btn btn--rose" href={site.bookingUrl}>{h.hero.bookButton}</a>
            <a class="h-textlink" href={h.hero.exploreLink}>{h.hero.exploreButton} <span aria-hidden="true">→</span></a>
          </div>
        </div>

      </div>
    </section>

    <!-- ============ KEY FIGURES (src/content/home.md → stats; hidden while show is false) ============
         Four facts in a row under the hero. Styles: "Key figures" in public/css/home.css;
         the count-up is in public/js/main.js. -->
    {h.stats.show && <section class="ledger" id="numbers" aria-labelledby="ledger-title">
      <div class="h-container">
        <h2 class="visually-hidden" id="ledger-title">{h.stats.eyebrow}</h2>
        <ul class="ledger__row" data-reveal="stagger">
          {h.stats.items.map((st: any) => (
            <li class="ledger__item">
              <p class="ledger__num"><span data-count={st.count ? st.value.replace(/\D/g, "") : undefined}>{st.value}</span>{st.suffix}</p>
              <p class="ledger__label">{st.label}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>}

    <!-- ============ 1. FIND A TREATMENT ============
         Heading: src/content/home.md → services. Face / Body / Wellness tiles: src/components/CategoryTiles.astro
         (same as the Treatments page). The signature list (SignatureCard rows) shows only while
         services.showList is true. -->
    <section class="h-section sig" id="services">
      <div class="h-container">
        <!-- Heading in the style of a beauty magazine: bold uppercase words crossed by a large
             italic line in the brand red; a short line and a button on the right -->
        <header class="find-head" data-reveal>
          <div>
            <p class="eyebrow">{h.services.eyebrow}</p>
            <h2 class="find-title">{findBefore}{findEm && <em>{findEm}</em>}{findAfter}</h2>
          </div>
          <div class="find-side">
            {h.services.intro && <p class="find-side__text">{h.services.intro}</p>}
            {h.services.button && <a class="btn find-side__btn" href={site.bookingUrl}>{h.services.button}</a>}
          </div>
        </header>
        <div class:list={["tp", "tp--embed", { "show-hints": treatmentsData.config.showPlaceholderHints }]}>
          <CategoryTiles compact />
        </div>
        {h.services.showList && (
          <div class:list={["tp", "tp--embed", "sig-layout", { "show-hints": treatmentsData.config.showPlaceholderHints }]}>
            <div class="sig-stage" aria-hidden="true">
              <div class="sig-stage__frame">
                {h.services.items.map((t, i) => (
                  <div class:list={["sig-stage__img", { "is-on": i === 0 }]} data-index={i}>
                    {t.image
                      ? <img src={t.image} alt="" loading="lazy" decoding="async" />
                      : <div class="ph" data-cat={t.category}><div class="ph-inner"><span class="ph-hint">Photo · 900 × 900</span></div></div>}
                  </div>
                ))}
              </div>
              <p class="sig-stage__count"><span class="sig-stage__now">01</span> / {String(h.services.items.length).padStart(2, "0")}</p>
            </div>
            <div class="sig-list">
              {h.services.items.map((t, i) => <SignatureCard t={t} index={i} />)}
            </div>
            <BookingSheet />
          </div>
        )}
        {h.services.showList && (
          <div class="h-center">
            <a class="h-textlink" href={h.services.menuLink}>{h.services.menuButton} <span aria-hidden="true">→</span></a>
          </div>
        )}
      </div>
    </section>

    <!-- ============ AD BANNER (src/content/home.md → banner) ============
         Picture with words and a button on its plain left side (wide screens); on phones the
         words sit under the picture. Styles: "Ad banner" in public/css/home.css. -->
    <section class:list={["h-banner", { "h-banner--copy": bannerHasCopy }]} aria-label="Promotion" data-reveal="wipe">
      <div class="h-container h-container--full">
        {h.banner?.image
          ? (h.banner.link && !bannerHasCopy
              ? <a class="h-banner__frame" href={h.banner.link}><img src={h.banner.image} alt={h.banner.alt} loading="lazy" style={`object-position:${h.banner.phoneFocus || "center"} center`} /></a>
              : (
                <div class="h-banner__frame">
                  <img src={h.banner.image} alt={h.banner.alt} loading="lazy" style={`object-position:${h.banner.phoneFocus || "center"} center`} />
                  {bannerHasCopy && (
                    <div class="h-banner__copy">
                      {h.banner.eyebrow && <p class="eyebrow">{h.banner.eyebrow}</p>}
                      <h2 class="h-banner__title">{bannerBefore}{bannerEm && <em>{bannerEm}</em>}{bannerAfter}</h2>
                      {h.banner.text && <p class="h-banner__text">{h.banner.text.replace("{count}", String(treatmentData.treatments.length))}</p>}
                      {h.banner.button && <a class="btn btn--rose" href={h.banner.buttonLink}>{h.banner.button}</a>}
                    </div>
                  )}
                </div>
              ))
          : (
            <div class="h-banner__frame h-banner__frame--ph" role="img" aria-label="Ad banner placeholder">
              <span class="h-banner__label">Ad banner</span>
              <span class="h-banner__size">1920 × 480</span>
            </div>
          )}
      </div>
    </section>

    <!-- ============ OUR CLIENTS' FAVOURITES (src/content/home.md → favourites) ============
         Cards: src/components/FavouriteCard.astro, the same card as the treatment list (styles ".tp .card" in treatments.css). -->
    {favs.length > 0 && (
      <section class="h-section h-section--tint fav" id="favourites">
        <div class="h-container">
          <header class="fav-head" data-reveal>
            <div>
              <p class="eyebrow">{h.favourites.eyebrow}</p>
              <h2 class="h-title">{favBefore}{favEm && <em>{favEm}</em>}{favAfter}</h2>
            </div>
            <a class="h-textlink" href="/rituals/">{h.favourites.allLink.replace("{count}", String(treatmentData.treatments.length))} <span aria-hidden="true">→</span></a>
          </header>
          <div class:list={["tp", "tp--embed", { "show-hints": treatmentsData.config.showPlaceholderHints }]}>
            <div class="fav-grid" data-reveal="stagger">
              {favs.map((t: any, i: number) => <FavouriteCard t={t} index={i} bookLabel={h.favourites.bookButton} />)}
            </div>
            {!h.services.showList && <BookingSheet />}
          </div>
        </div>
      </section>
    )}

    <!-- ============ FIRST-VISIT BAND (src/content/home.md → trial) ============
         Words over the studio photo (1280 × 560) with a burgundy tint. Styles: "First-visit band"
         in public/css/home.css. -->
    {h.trial?.heading && (
      <section class="trial" id="first-visit" style={h.trial.image ? `--trial-img:url("${h.trial.image}")` : undefined}>
        <div class="h-container trial__inner" data-reveal>
          <p class="trial__eyebrow">{h.trial.eyebrow}</p>
          <h2 class="trial__title">{trialBefore}{trialEm && <em>{trialEm}</em>}{trialAfter}</h2>
          <p class="trial__text">{h.trial.text}</p>
          <p class="trial__note">
            {h.trial.note}{" "}
            {trialTerms ? <a href={trialTerms}>{h.trial.termsLabel}</a> : <span>{h.trial.termsLabel}</span>}
          </p>
          <div class="trial__actions">
            <a class="btn trial__book" href={site.bookingUrl}>{h.trial.bookButton}</a>
            <a class="btn trial__explore" href={h.trial.exploreLink}>{h.trial.exploreButton} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    )}

    <!-- ============ REAL RESULTS (src/content/home.md → results; results from src/data/results/) ============
         Before/after photos only show for results with consent: true. Reviews: testimonials in home.md.
         Styles: "Real results" in public/css/home.css. -->
    {h.results && (
      <section class="h-section res" id="results">
        <div class="h-container">
          <header class="fav-head" data-reveal>
            <div>
              <p class="eyebrow">{h.results.eyebrow}</p>
              <h2 class="h-title">{resBefore}{resEm && <em>{resEm}</em>}{resAfter}</h2>
            </div>
            <a class="h-textlink" href={h.results.allHref}>{h.results.allLink} <span aria-hidden="true">→</span></a>
          </header>
          {resultCards.length > 0 && (
            <ul class="res-grid" data-reveal="stagger">
              {resultCards.map((r) => (
                <li class="res-card">
                  {r.single
                    ? <div class="res-pair res-pair--one"><img src={r.single} alt={r.alt} loading="lazy" /></div>
                    : (
                      <div class="res-pair" role={r.before || r.after ? "group" : undefined} aria-label={r.before || r.after ? r.alt : undefined}>
                        <div class="res-shot">{r.before && <img src={r.before} alt="" loading="lazy" />}<span>Before</span></div>
                        <div class="res-shot">{r.after && <img src={r.after} alt="" loading="lazy" />}<span>After</span></div>
                      </div>
                    )}
                  <a class="res-caption" href={r.link}>{r.name}{r.note && <> · {r.note}</>} <span aria-hidden="true">→</span></a>
                </li>
              ))}
            </ul>
          )}
          <!-- Reviews: one list, shown twice in a row so it can scroll by endlessly (the copy is
               hidden from screen readers). Styles: .res-marquee in home.css. -->
          <div class="res-marquee" data-reveal>
            {[0, 1].map((copy) => (
              <ul class="res-reviews" aria-hidden={copy === 1 ? "true" : undefined}>
                {h.testimonials.items.map((r: any) => (
                  <li class="res-review">
                    <div class="res-review__head">
                      <span class="res-avatar" aria-hidden="true" style={`--hue:${avatarHue(r.name)}`}>{r.name.trim().charAt(0).toUpperCase()}</span>
                      <span class="res-review__who">
                        <b>{r.name}</b>
                        <small>{r.studio}</small>
                      </span>
                      <svg class="res-g" viewBox="0 0 48 48" aria-label="Google review" role="img"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
                    </div>
                    {stars(r.rating) > 0 && <p class="res-stars" aria-label={`${stars(r.rating)} out of 5 stars`}>{"★".repeat(stars(r.rating))}</p>}
                    <blockquote class="res-quote">{r.quote}</blockquote>
                    {googleFor(r.studio) && <a class="res-more" href={googleFor(r.studio)} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : undefined}>{h.results.reviewSource}<span class="visually-hidden"> (opens Google)</span></a>}
                  </li>
                ))}
              </ul>
            ))}
          </div>
          {h.testimonials.trust?.length > 0 && (
            <ul class="trust" data-reveal>
              {h.testimonials.trust.map((t: string) => <li>{t}</li>)}
            </ul>
          )}
        </div>
      </section>
    )}

    <!-- ============ PRODUCTS (src/content/home.md → products; nav "Shop" links here) ============ -->
    {h.products.show && <section class="h-section" id="shop">
      <div class="h-container">
        <header class="h-split-head" data-reveal>
          <div>
            <p class="eyebrow">{h.products.eyebrow}</p>
            <h2 class="h-title">{h.products.heading}</h2>
          </div>
          <p class="h-intro">{h.products.intro}</p>
        </header>
        <div class:list={["tp", "tp--embed", { "show-hints": treatmentsData.config.showPlaceholderHints }]}>
          <div class="shop-grid" data-reveal="stagger">
            {h.products.items.map((p) => <ProductCard p={p} linkLabel={h.products.linkLabel} />)}
          </div>
        </div>
        {realUrl(h.products.menuLink) && (
          <div class="h-center">
            <a class="h-textlink" href={h.products.menuLink}>{h.products.menuButton} <span aria-hidden="true">→</span></a>
          </div>
        )}
      </div>
    </section>}

    <!-- ============ 2. OUR STORY (src/content/home.md → experience) ============
         Archive photo left; story, milestones and "Read our story" right.
         Styles: "Our story" in public/css/home.css. -->
    <section class="h-section story" id="experience">
      <div class="h-container story__grid">
        <div class="story__media" data-reveal>
          <figure class="story__photo">
            <img src={h.experience.image} alt={h.experience.imageAlt} loading="lazy" />
            {h.experience.caption && <figcaption>{h.experience.caption}</figcaption>}
          </figure>
          {(h.experience.image2 || (h.experience.image2Caption && treatmentsData.config.showPlaceholderHints)) && (
            <figure class="story__inset">
              {h.experience.image2
                ? <img src={h.experience.image2} alt={h.experience.image2Alt} loading="lazy" />
                : <div class="story__inset-ph" role="img" aria-label="Photo to come">Photo to come</div>}
              {h.experience.image2Caption && <figcaption>{h.experience.image2Caption}</figcaption>}
            </figure>
          )}
        </div>
        <div class="story__copy" data-reveal>
          <p class="eyebrow">{h.experience.eyebrow}</p>
          <h2 class="h-title story__title">{storyBefore}{storyEm && <em>{storyEm}</em>}{storyAfter}</h2>
          {h.experience.paragraphs.map((p: string) => <p class="h-body">{p}</p>)}
          {h.experience.milestones?.length > 0 && (
            <ul class="story__miles">
              {h.experience.milestones.map((m: any) => (
                <li><span class="story__year">{m.year}</span><span class="story__label">{m.label}</span></li>
              ))}
            </ul>
          )}
          <a class="h-textlink" href={h.experience.linkHref || "/about/"}>{h.experience.link} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ============ 5. LOCATION, HOURS & INFO ============ -->
    <section class="h-section h-section--tint" id="visit">
      <div class="h-container">
        <header class="h-head" data-reveal>
          <p class="eyebrow">{h.visit.eyebrow}</p>
          <h2 class="h-title">{h.visit.heading}</h2>
        </header>
        <div class="visit" data-reveal>
          <ul class="h-studios">
            {outlets.map((o, i) => {
              const wa = waHref(o.whatsapp);
              return (
                <li class="h-studio" data-map={mapEmbed(o.mapsUrl)} data-name={o.name} aria-current={i === 0 ? "true" : undefined}>
                  <h3 class="h-studio__name"><button type="button" class="h-studio__pick">{o.name}</button></h3>
                  <p class="h-studio__line">{o.address}, Singapore {o.postalCode}</p>
                  <p class="h-studio__line">{o.hours}</p>
                  <p class="h-studio__line">
                    <a href={tel(o.phone)}>{o.phone}</a>
                    <span aria-hidden="true"> · </span>
                    {wa ? <a href={wa}>WhatsApp {o.mobile}</a> : <span>{o.whatsapp}</span>}
                  </p>
                </li>
              );
            })}
          </ul>
          <div class="visit__side">
            {/* Live Google map of the selected studio: tap a studio in the list to switch it
                (public/js/home.js). Each map comes from mapsUrl in src/data/outlets.json;
                directions and "Open in Maps" are on the map itself. */}
            <div class="visit-map">
              <iframe src={mapEmbed(outlets[0].mapsUrl)} title={`Map: Mary Chia ${outlets[0].name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 6. FINAL CTA ============ -->
    <section class="h-final" id="book">
      <div class="h-container h-final__inner" data-reveal>
        <h2 class="h-final__title">{h.finalCta.heading}</h2>
        <p class="h-final__text">{h.finalCta.text}</p>
        <div class="h-final__actions">
          <a class="btn btn--hero" href={bookHref}>{h.finalCta.button}</a>
          <a class="btn btn--hero btn--ghost" href="#visit">{h.finalCta.secondary}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
