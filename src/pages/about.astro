---
/**
 * About Us page template.
 * Words come from src/content/about.md. Studio map, studio cards and the
 * enquiry form live on the Contact Us page (src/pages/contact.astro).
 * To change copy, edit the content file — not this one.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
import { frontmatter as c } from "../content/about.md";

const first = c.milestones[0];
// Hero heading: the *word* in asterisks shows in italic rose
const [heroBefore, heroEm = "", heroAfter = ""] = c.hero.heading.split("*");

// schema.org: the organisation (studios are described on the Contact page)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: new URL("/images/logo.png", site.url).href,
  slogan: site.tagline,
};
---
<Base
  title={c.seo.title}
  description={c.seo.description}
  current="about"
  bodyClass="page-about"
  styles={["about.css"]}
  scripts={["about.js"]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
    <!-- ============ 1. HERITAGE OPENING ============ -->
    <div class="heritage-opening" id="story">
      {c.hero.image && <img class="heritage-opening__photo" src={c.hero.image} alt={c.hero.imageAlt || ""} fetchpriority="high" />}
      <section class="heritage-hero">
        <div class="a-container heritage-hero__inner">
          <p class="heritage-hero__eyebrow">{c.hero.eyebrow}</p>
          <h1 class="heritage-hero__title">{heroBefore}{heroEm && <em>{heroEm}</em>}{heroAfter}</h1>
          {c.hero.tagline && <p class="heritage-hero__tagline">{c.hero.tagline}</p>}
          <p class="heritage-hero__lede">{c.hero.lede}</p>
          {c.hero.facts?.length > 0 && (
            <ul class="heritage-facts">
              {c.hero.facts.map((f: any) => (
                <li><strong>{f.value}</strong><span>{f.label}</span></li>
              ))}
            </ul>
          )}
        </div>
      </section>
      {c.hero.explore && (
        <div class="a-container">
          <a class="heritage-portal" href="#heritage-timeline">
            <strong>{c.hero.explore}</strong>
            <small>{c.hero.range}</small>
            <span class="heritage-portal__ring" aria-hidden="true"><b>&#8595;</b></span>
          </a>
        </div>
      )}
    </div>

    <!-- ============ 2. TIMELINE ============ -->
    <section class="storyline" aria-label="Our history">
      <div class="a-container storyline-grid" id="heritage-timeline">
        <div class="storyline-sticky" aria-hidden="true">
          <p class="sl-year" id="sl-year">{first.year}</p>
          <div class="sl-track"><div class="sl-progress" id="sl-progress"></div></div>
          <p class="sl-label" id="sl-label">{first.title}</p>
        </div>

        <div class="storyline-feed">
          {c.milestones.map((m) => (
            <article class="sl-item" data-year={m.year}>
              <figure class="sl-inline-media">
                {m.image
                  ? <img src={m.image} alt={m.imageAlt} loading="lazy" />
                  : (
                    <div class="heritage-ph" role="img" aria-label={m.imageAlt}>
                      <span class="heritage-ph__year">{m.year}</span>
                      <span class="heritage-ph__label">{c.imagePlaceholder}</span>
                    </div>
                  )}
              </figure>
              <p class="sl-y-mobile">{m.year}</p>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </article>
          ))}
        </div>

        <div class="storyline-media" aria-hidden="true">
          {c.milestones.map((m, i) => (
            <div class:list={["sl-media-item", { on: i === 0 }]} data-year={m.year}>
              {m.image
                ? <img src={m.image} alt="" />
                : (
                  <div class="heritage-ph heritage-ph--circle">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-8 8"/></svg>
                    <span class="heritage-ph__year">{m.year}</span>
                    <span class="heritage-ph__label">{c.imagePlaceholder}</span>
                    <span class="heritage-ph__hint">{m.imageAlt}</span>
                  </div>
                )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Chapter close: a line draws down to "the story continues", then Vision & Mission opens on a curved tint panel -->
    {c.storyClose && (
      <div class="story-close">
        <span class="story-close__line" aria-hidden="true"></span>
        <p class="story-close__text">{c.storyClose}</p>
      </div>
    )}

    <!-- ============ 3. VISION & MISSION (hidden while visionMission.show is false) ============ -->
    {c.visionMission?.show !== false && (
    <section class="a-section vm-section" id="vision-mission">
      <div class="a-container">
        <header class="a-head a-head--center">
          <p class="eyebrow">{c.visionMission.eyebrow}</p>
          <h2 class="a-title">{c.visionMission.heading}</h2>
          <p class="a-lede">{c.visionMission.subtitle}</p>
          {c.visionMission.confirm && <p class="a-note">{c.visionMission.confirm}</p>}
        </header>
        <div class="mvgrid">
          <article class="mv">
            <span class="mv__index">01</span>
            <h3>Mission</h3>
            <p>{c.visionMission.mission}</p>
          </article>
          <article class="mv">
            <span class="mv__index">02</span>
            <h3>Vision</h3>
            <p>{c.visionMission.vision}</p>
          </article>
        </div>
        <a class="vm-next" href="/contact/#locations"><span>{c.visionMission.next}</span><i aria-hidden="true">&#8595;</i></a>
        {c.visionMission.investorsLink && (
          <p class="vm-ir">{c.visionMission.investorsText} <a class="link-arrow" href="/investors/">{c.visionMission.investorsLink}</a></p>
        )}
      </div>
    </section>
    )}

  </main>

  <Footer />
</Base>
