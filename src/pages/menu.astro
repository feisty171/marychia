---
/**
 * Full treatment menu page (/menu/). The "Full menu" buttons normally open the pop-up viewer
 * (src/components/MenuViewer.astro); this page is the fallback when JavaScript is off,
 * and a direct link you can share.
 *
 * Shows the menu PDF as one image per page, so it opens in every browser (including
 * in-app browsers on Instagram / WhatsApp that would otherwise download the PDF).
 * The page images live in public/menu/pages/ and are made from public/menu/full-spa-menu.pdf:
 * after replacing the PDF, run `sh scripts/menu-images.sh`. This page picks up however many pages there are.
 * Styles: public/css/menu.css
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { menuPages, MENU_PAGE_W as W, MENU_PAGE_H as H } from "../lib/menuPages";

const pages = menuPages();
const total = pages.length;
---
<Base
  title="Treatment Menu | Mary Chia"
  description="Browse Mary Chia's full treatment menu: face, body and wellness rituals, sessions and prices."
  current="treatments"
  solidHeader
  bodyClass="page-menu"
  styles={["menu.css"]}
>
  <main class="mn">
    <div class="mn-wrap">
      <a class="mn-back" href="/treatments/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 12H5m5-5-5 5 5 5"/></svg>
        Back to Treatments
      </a>
      <header class="mn-head">
        <p class="eyebrow">Full menu</p>
        <h1 class="mn-title">Our treatment <em>menu</em></h1>
        <p class="mn-lede">Every face, body and wellness ritual in one place. Not sure where to start? Our therapists will help you choose on the day.</p>
      </header>

      {total > 0 ? (
        <ol class="mn-pages" aria-label={`Treatment menu, ${total} pages`}>
          {pages.map((f, i) => (
            <li class="mn-page" id={`page-${i + 1}`}>
              <img
                src={f}
                alt={`Treatment menu, page ${i + 1} of ${total}`}
                width={W}
                height={H}
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
              />
              <span class="mn-num" aria-hidden="true">{i + 1} / {total}</span>
            </li>
          ))}
        </ol>
      ) : (
        <p class="mn-empty">The menu is being updated. Please check back soon.</p>
      )}

      <div class="mn-cta">
        <a class="btn btn--solid" href="/rituals/">Find your treatment</a>
      </div>
    </div>
  </main>

  <Footer />
</Base>
