---
/**
 * Site footer: logo, quick links, social icons and the outlet list.
 * Links and socials come from src/data/site.json; outlets from src/data/outlets.json.
 * Optional `note` prop shows a small line under the logo (e.g. price terms).
 * `anchor={false}` drops id="contact" on pages that have their own Contact section.
 */
import outlets from "../data/outlets.json";
import site from "../data/site.json";
import { tel, realUrl } from "../lib/links";

interface Props {
  note?: string;
  anchor?: boolean;
}
const { note, anchor = true } = Astro.props;

const icons: Record<string, string> = {
  Instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>',
  Facebook: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/>',
  TikTok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 3 2.5 5 5.5 5"/>',
};
const pendingLinks = [...site.footerLinks, ...site.socials.map((s) => ({ label: s.name, href: s.url }))]
  .filter((l) => !realUrl(l.href) && !l.href.startsWith("/") && !l.href.startsWith("#"));
---
<footer class="site-footer" id={anchor ? "contact" : undefined}>
  <div class="footer-container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <img class="site-footer__logo" src="/images/logo-emblem.webp" alt="Mary Chia — Face • Body • Wellness" width="426" height="360" />
        {note && <p class="site-footer__note">{note}</p>}
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        <ul class="footer-links">
          {site.footerLinks.map((l) => {
            const href = l.href.startsWith("#") ? l.href : realUrl(l.href);
            return <li>{href ? <a href={href}>{l.label}</a> : <span class="footer-links__pending">{l.label}</span>}</li>;
          })}
        </ul>
        <ul class="socials">
          {site.socials.map((s) => {
            const url = realUrl(s.url);
            const svg = `<svg viewBox="0 0 24 24" aria-hidden="true">${icons[s.name] ?? ""}</svg>`;
            return (
              <li>
                {url
                  ? <a href={url} target="_blank" rel="noopener" aria-label={s.name} set:html={svg} />
                  : <span class="socials__pending" title={s.url} aria-label={s.name} set:html={svg} />}
              </li>
            );
          })}
        </ul>
      </nav>
    </div>

    {pendingLinks.length > 0 && (
      <p class="site-footer__pending">{pendingLinks.map((l) => l.href).join(" ")}</p>
    )}

    <div class="outlets">
      {outlets.map((o) => (
        <div class="outlet">
          <h3 class="outlet__name">{o.name}</h3>
          <p class="outlet__addr">{o.address}<br />Singapore {o.postalCode}</p>
          <p class="outlet__tel">
            <a href={tel(o.phone)}>O: {o.phone}</a> <span aria-hidden="true">|</span> <a href={tel(o.mobile)}>M: {o.mobile}</a>
          </p>
        </div>
      ))}
    </div>
    <p class="site-footer__legal">&copy; {new Date().getFullYear()} Mary Chia. All rights reserved.</p>
  </div>
</footer>
