---
/**
 * Home page signature card: a simple card (photo, name, price, Book now),
 * four in a row on desktop, two by two on phones.
 * Content: src/content/home.md → services.items. Styles: public/css/home.css (.sig-*).
 * Price: "from S$xx" = the lowest option price, with that option's compareAt crossed out (if any).
 * "Book now" opens the WhatsApp studio picker (public/js/treatment-cards.js + BookingSheet.astro).
 */
interface Props {
  t: {
    id: string;
    name: string;
    category: string;
    tag?: string;
    for: string;
    description: string;
    image?: string;
    imageAlt?: string;
    options: { label: string; minutes: number; price: number; compareAt?: number }[];
  };
  index?: number;
}
const { t, index = 0 } = Astro.props;

const money = (n: number) => "S$" + n.toLocaleString("en-SG");
const cheapest = t.options.reduce((a, b) => (b.price < a.price ? b : a));

const ICONS: Record<string, string> = {
  Face: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M12 3c-3.6 0-6 2.9-6 6.8 0 4.6 2.8 8.7 6 10.2 3.2-1.5 6-5.6 6-10.2C18 5.9 15.6 3 12 3Z"/><path d="M9.3 10.2h.01M14.7 10.2h.01M10 14.6c1.2.8 2.8.8 4 0"/></svg>',
  Body: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M3 15c3-1 4.5-3.5 9-3.5S18 14 21 15"/><path d="M5 18.5c2.4-.7 3.8-2 7-2s4.6 1.3 7 2"/><circle cx="12" cy="6.5" r="2.5"/></svg>',
  Wellness: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M12 21c-4-2.5-7-5.6-7-9.5C5 8 7.2 6 9.6 6c1 0 1.8.4 2.4 1 .6-.6 1.4-1 2.4-1C16.8 6 19 8 19 11.5c0 3.9-3 7-7 9.5Z"/><path d="M12 3v3M8.5 12.5c1 1.2 2.2 1.8 3.5 1.8s2.5-.6 3.5-1.8"/></svg>',
};
---
<article class="sig-card" style={`--i:${index}`} data-id={t.id} data-name={t.name}>
  <div class="sig-media">
    {t.image
      ? <img src={t.image} alt={t.imageAlt ?? t.name} loading="lazy" decoding="async" />
      : (
        <div class="ph" data-cat={t.category} role="img" aria-label={t.imageAlt ?? t.name}>
          <div class="ph-inner">
            <span class="ph-icon" set:html={ICONS[t.category] ?? ICONS.Wellness} />
            <span class="ph-hint">Photo · 900 × 900</span>
          </div>
        </div>
      )}
  </div>

  <div class="sig-body">
    <h3>{t.name}</h3>
    <p class="sig-for">{t.for}</p>
    <p class="sig-price">
      <span class="sig-price__from">From</span>
      <b>{money(cheapest.price)}</b>
      {cheapest.compareAt && <s aria-label={`usual price ${money(cheapest.compareAt)}`}>{money(cheapest.compareAt)}</s>}
    </p>
    <button type="button" class="sig-book js-book">
      Book now
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
    </button>
  </div>
</article>
