---
/**
 * Home page signature treatment: one numbered row of the editorial list
 * (number, name, the short "for" line, "from S$xx" price, Book now).
 * Content: src/content/home.md → services.items. Styles: public/css/home.css (.sig-*).
 * On wide screens the big photo beside the list (in src/pages/index.astro) shows the
 * row you're on (public/js/home.js); on phones and tablets the row shows its own small photo.
 * Price: "from S$xx" = the lowest option price, with that option's compareAt crossed out (if any).
 * "Book now" opens the WhatsApp studio picker (public/js/treatment-cards.js + BookingSheet.astro).
 */
interface Props {
  t: {
    id: string;
    name: string;
    category: string;
    tag?: string;
    for: string;
    description: string;
    image?: string;
    imageAlt?: string;
    options: { label: string; minutes: number; price: number; compareAt?: number }[];
  };
  index?: number;
}
const { t, index = 0 } = Astro.props;

const money = (n: number) => "S$" + n.toLocaleString("en-SG");
const cheapest = t.options.reduce((a, b) => (b.price < a.price ? b : a));
const num = String(index + 1).padStart(2, "0");
---
<article class="sig-row" style={`--i:${index}`} data-id={t.id} data-name={t.name} data-index={index} data-reveal>
  <span class="sig-row__num" aria-hidden="true">{num}</span>

  <div class="sig-row__thumb">
    {t.image
      ? <img src={t.image} alt="" loading="lazy" decoding="async" />
      : <div class="ph" data-cat={t.category}><div class="ph-inner"><span class="ph-hint">Photo · 900 × 900</span></div></div>}
  </div>

  <div class="sig-row__main">
    <p class="sig-row__cat">{t.category}{t.tag && <span> · {t.tag}</span>}</p>
    <h3 class="sig-row__name">{t.name}</h3>
    <p class="sig-row__for">{t.for}</p>
  </div>

  <div class="sig-row__side">
    <p class="sig-price">
      <span class="sig-price__from">From</span>
      <b>{money(cheapest.price)}</b>
      {cheapest.compareAt && <s aria-label={`usual price ${money(cheapest.compareAt)}`}>{money(cheapest.compareAt)}</s>}
    </p>
    <button type="button" class="sig-book js-book">
      Book now
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
    </button>
  </div>
</article>
